{
  "name": "accountable",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "check:staged": "node scripts/check.mjs --staged",
    "format": "node scripts/check.mjs --format",
    "test": "node scripts/test.mjs",
    "test:ui": "npm run test --workspace frontend",
    "test:api": "node scripts/python.mjs -m pytest",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace frontend",
    "save": "node scripts/python.mjs -m backend.data_commands save",
    "load": "node scripts/python.mjs -m backend.data_commands load",
    "seed": "node scripts/python.mjs -m backend.data_commands seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "lefthook": "^2.2.2"
  }
}
